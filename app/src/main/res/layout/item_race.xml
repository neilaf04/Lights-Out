<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/hero_card"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/roundText"
        android:text="ROUND 1"
        android:textColor="#E10600"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/raceNameText"
        android:text="Monaco Grand Prix"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/circuitText"
        android:text="Circuit de Monaco"
        android:textColor="#D0D0DD"
        android:textSize="15sp"
        android:layout_marginTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/countryDateText"
        android:text="Monaco • 2026-05-25"
        android:textColor="#A5A5B5"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_marginBottom="16dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/teamStripe"
        android:layout_width="7dp"
        android:layout_height="match_parent"
        android:background="#E10600" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/teamPositionText"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="01"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/teamCarImage"
            android:layout_width="135dp"
            android:layout_height="95dp"
            android:scaleType="fitCenter"
            android:src="@drawable/redbull_car"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/teamNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Red Bull Racing"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/teamSubtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Constructor"
                android:textColor="#A5A5B5"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/teamPointsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="437 PTS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>